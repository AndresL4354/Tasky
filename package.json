{
  "name": "tasky",
  "private": true,
  "version": "2.0.0",
  "description": "Gestor de tareas por proyecto con estética de editor de código",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "build:app": "tauri build --bundles app",
    "build:dmg": "tauri build --bundles app,dmg && sh scripts/clean-dmg-apps.sh",
    "install:mac": "tauri build --bundles app && sh scripts/install-mac.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
